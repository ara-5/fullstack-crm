// PostgreSQL schema. Enum-like fields (role, stage, status…) are plain strings
// validated in src/lib/validation.ts, so allowed values can evolve without a
// database migration. Allowed values live in src/lib/constants.ts.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (e.g. Neon pooler) at runtime
  directUrl = env("DIRECT_URL") // direct connection for migrations
}

model User {
  id                     String   @id @default(cuid())
  name                   String
  email                  String   @unique
  passwordHash           String
  role                   String   @default("REP") // ADMIN | MANAGER | REP
  active                 Boolean  @default(true)
  twoFactorSecret        String? // base32; set as soon as setup begins, only trusted once twoFactorEnabled
  twoFactorEnabled       Boolean  @default(false)
  twoFactorRecoveryCodes Json? // array of bcrypt hashes, each usable once
  twoFactorLastUsedStep  Int? // TOTP step counter of the last code accepted at login, so a captured code can't be replayed
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  companies     Company[]      @relation("CompanyOwner")
  contacts      Contact[]      @relation("ContactOwner")
  deals         Deal[]         @relation("DealOwner")
  activities    Activity[]     @relation("ActivityOwner")
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  notifications Notification[]
  presences     Presence[]
  savedViews    SavedView[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  industry  String?
  size      String?
  phone     String?
  address   String?
  ownerId   String?
  owner     User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  @@index([ownerId])
  @@index([name])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  status    String   @default("LEAD") // LEAD | PROSPECT | CUSTOMER | CHURNED
  source    String?
  tags      String   @default("") // comma-separated, normalized lowercase
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals      Deal[]
  activities Activity[]

  @@index([ownerId])
  @@index([email])
  @@index([status])
}

model Deal {
  id            String    @id @default(cuid())
  title         String
  value         Float     @default(0)
  currency      String    @default("USD")
  stage         String    @default("LEAD") // see DEAL_STAGES
  probability   Int       @default(10)
  expectedClose DateTime?
  closedAt      DateTime?
  aiInsights    Json? // latest AI assistant output (see src/lib/ai.ts)
  aiInsightsAt  DateTime?
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  activities Activity[]

  @@index([stage])
  @@index([ownerId])
}

model Activity {
  id          String    @id @default(cuid())
  type        String // TASK | CALL | MEETING | EMAIL | NOTE
  subject     String
  body        String?
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueAt       DateTime?
  completedAt DateTime?
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  ownerId     String?
  owner       User?     @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId, completedAt])
  @@index([dueAt])
}

model AutomationRule {
  id           String    @id @default(cuid())
  name         String
  active       Boolean   @default(true)
  trigger      String // a CrmEvent, e.g. "deal.stage_changed"
  conditions   String    @default("{}") // JSON: { toStage?, fromStage?, minValue?, contactStatus? }
  action       String // CREATE_TASK | SEND_EMAIL | UPDATE_CONTACT_STATUS
  actionConfig String    @default("{}") // JSON, shape depends on action
  runCount     Int       @default(0)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Webhook {
  id              String    @id @default(cuid())
  url             String
  events          String // comma-separated CrmEvents, or "*"
  secret          String
  active          Boolean   @default(true)
  lastStatus      Int?
  lastError       String?
  failureCount    Int       @default(0) // consecutive failed deliveries; auto-disabled at 10
  lastDeliveredAt DateTime?
  createdAt       DateTime  @default(now())
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  keyHash    String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  status    String // SENT | LOGGED | FAILED
  error     String?
  contactId String?
  createdAt DateTime @default(now())

  @@index([contactId])
}

/// Who changed what, and when. Written by the service layer (src/lib/crm.ts).
model AuditLog {
  id         String   @id @default(cuid())
  entityType String // contact | company | deal | activity
  entityId   String
  action     String // created | updated | deleted | stage_changed | completed | reopened
  summary    String?
  changes    Json? // { field: { from, to } }
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

/// Fixed-window counters for rate limiting (works across serverless instances).
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

/// In-app notifications (assignment, deal outcome, automation-created tasks).
model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // assigned | deal_won | deal_lost | task_assigned
  title      String
  body       String?
  entityType String?
  entityId   String?
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read, createdAt])
}

/// Who's looking at a record right now, refreshed by a client heartbeat.
/// Rows older than the active window are ignored by readers, not deleted eagerly.
model Presence {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  lastSeenAt DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId, lastSeenAt])
}

/// A saved filter set for a list page (contacts or companies), per user.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity    String // contacts | companies
  name      String
  filters   Json
  createdAt DateTime @default(now())

  @@index([userId, entity])
}
