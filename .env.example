# SQLite for local development. For Postgres, set provider = "postgresql" in
# prisma/schema.prisma and use e.g. postgresql://user:pass@host:5432/crm
DATABASE_URL="file:./dev.db"

# Generate with: npx auth secret
AUTH_SECRET="replace-me"

# Optional SMTP. Without it, emails are logged to the console and EmailLog.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CRM <no-reply@example.com>"
