# ---- Database (PostgreSQL)
# Local: `docker compose up -d` starts Postgres on port 5433 with these credentials.
# Neon/Supabase: DATABASE_URL = pooled connection string, DIRECT_URL = direct (non-pooled) one.
DATABASE_URL="postgresql://crm:crm@localhost:5433/crm"
DIRECT_URL="postgresql://crm:crm@localhost:5433/crm"

# ---- Auth (required in production). Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"

# ---- App
CURRENCY="USD"                 # reporting currency; totals only include deals in this currency
DEMO_MODE="false"              # "true" for a public demo: one-click logins, no real emails/webhooks, locked settings
CRON_SECRET=""                 # required for the nightly demo reset AND for /api/cron/process-jobs
                                # (Vercel Cron sends it as a Bearer token to both)
ALLOW_PRIVATE_WEBHOOKS="false" # "true" only for local testing against localhost receivers
TRUST_PROXY_HEADERS="false"    # "true" only if you're behind exactly one reverse proxy (Vercel, nginx, ...)
                                # that sets X-Forwarded-For itself; otherwise it's attacker-controlled and
                                # login rate limiting falls back to per-account limits only

# ---- Optional: AI assistant (deal summaries, follow-up email drafts, and the
# agentic AI command panel — Claude). Without it, both are simply hidden.
ANTHROPIC_API_KEY=""

# ---- Optional: semantic search over contacts/companies/deals, and better AI
# assistant retrieval (Voyage AI — Anthropic's recommended embedding partner,
# since Claude itself has no embeddings endpoint). Without it, search falls
# back to keyword matching only. Requires the pgvector extension (already on
# in the local docker-compose db; enable it on your hosted Postgres too:
# `CREATE EXTENSION IF NOT EXISTS vector;`).
VOYAGE_API_KEY=""

# ---- Optional: SMTP. Without it, emails are logged instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CRM <no-reply@example.com>"
